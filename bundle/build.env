# Build configuration for official builds. Committed so builds are reproducible.
# Override values locally in .env (ignored by Gradle builds, which pass --reproducible).

VIOLYTRA_DISCORD_SERVER_URL=https://discord.com/invite/dtBTQHYSx4
VIOLYTRA_SOURCE_REPOSITORY_URL=https://github.com/Violytra/violytra-mod
VIOLYTRA_LICENSE_URL=https://raw.githubusercontent.com/Violytra/violytra/main/LICENSE

# Required while any bundled plugin is a stub with a default source.
VIOLYTRA_DEFAULT_PLUGIN_REPOSITORY_URL=http://plugins.violytra.cc.cd/

# Optional
VIOLYTRA_DONATE_URL=https://github.com/sponsors/Violytra
